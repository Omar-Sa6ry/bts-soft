{
  "name": "@bts-soft/notifications",
  "version": "2.1.8",
  "author": "Omar Sabry",
  "description": "NestJS notifications module supporting email (Nodemailer), SMS (Twilio), push (Firebase), Telegram bot, and BullMQ queue integration.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:cov": "vitest run --coverage src",
    "test:e2e": "docker-compose -f docker-compose.e2e.yml up -d --wait --wait-timeout 60 && vitest run test/notification.e2e-spec.ts --passWithNoTests && docker-compose -f docker-compose.e2e.yml down",
    "test:e2e:local": "cross-env REDIS_PORT=6379 vitest run test/notification.e2e-spec.ts --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1159.0",
    "@nestjs/axios": ">=4.0.1",
    "@nestjs/bullmq": ">=11.0.5",
    "@onesignal/node-onesignal": "^5.20.0",
    "axios": "^1.21.0",
    "bullmq": ">=5.81.5",
    "class-transformer": ">=0.5.1",
    "class-validator": ">=0.15.1",
    "dotenv": "^18.0.9",
    "firebase-admin": "^13.10.0",
    "handlebars": "^4.7.10",
    "libphonenumber-js": "^1.13.15",
    "nestjs-i18n": ">=10.8.5",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^7.0.13",
    "pusher": "^5.3.4",
    "reflect-metadata": ">=0.2.2",
    "rxjs": ">=7.8.2",
    "twilio": "^5.13.1",
    "web-push": "^3.6.7"
  },
  "peerDependencies": {
    "@bts-soft/cache": ">=1.1.8",
    "@nestjs/common": ">=11.0.0",
    "@nestjs/config": ">=4.0.0",
    "@nestjs/core": ">=11.0.0",
    "@nestjs/graphql": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bts-soft/cache": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/graphql": "^14.1.0",
    "@nestjs/testing": "^12.3.2",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^7.0.12",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "bullmq": "^6.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Omar-Sa6ry/bts-soft.git",
    "directory": "packages/notifications"
  },
  "homepage": "https://github.com/Omar-Sa6ry/bts-soft/tree/main/packages/notifications#readme",
  "bugs": {
    "url": "https://github.com/Omar-Sa6ry/bts-soft/issues"
  }
}
