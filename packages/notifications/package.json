{
  "name": "@bts-soft/notifications",
  "version": "1.9.3",
  "author": "Omar Sabry",
  "description": "NestJS notifications module supporting email (Nodemailer), SMS (Twilio), push (Firebase), Telegram bot, and BullMQ queue integration.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:cov": "vitest run --coverage src",
    "test:e2e": "docker-compose -f docker-compose.e2e.yml up -d --wait --wait-timeout 60 && vitest run test --passWithNoTests && docker-compose -f docker-compose.e2e.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1155.0",
    "@nestjs/axios": ">=4.0.0",
    "@nestjs/bullmq": ">=11.0.0",
    "@onesignal/node-onesignal": "^5.20.0",
    "axios": "^1.3.1",
    "bullmq": ">=5.0.0",
    "class-transformer": ">=0.5.1",
    "class-validator": ">=0.14.1",
    "dotenv": "^18.0.8",
    "firebase-admin": "^13.10.0",
    "handlebars": "^4.7.10",
    "libphonenumber-js": "^1.13.15",
    "nestjs-i18n": ">=10.0.0",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^7.0.13",
    "pusher": "^5.3.4",
    "reflect-metadata": ">=0.2.0",
    "rxjs": ">=7.8.1",
    "twilio": "^5.13.1",
    "web-push": "^3.6.7"
  },
  "peerDependencies": {
    "@bts-soft/cache": ">=1.1.8",
    "@nestjs/common": ">=11.0.0",
    "@nestjs/config": ">=4.0.0",
    "@nestjs/core": ">=11.0.0",
    "@nestjs/graphql": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bts-soft/cache": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/testing": "^12.2.0",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "bullmq": "^6.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=10.0.0"
  }
}
